flowchart TD
    subgraph ADOTACAO["Adoção do feature-forge"]
        direction TB
        DEV1["Dev 1 (pioneiro)"]
        INIT["forge init"]
        CRIACAO["Cria .claude/:"]
        FILES_CREATED["workflow-config.yaml<br/>cards/ (snapshots)<br/>inventory/<br/>memory/L2-project.yaml<br/>hooks/<br/>memory/L1/*<br/>graph.db"]
    end

    INIT --> CRIACAO
    DEV1 --> INIT
    CRIACAO --> FILES_CREATED

    subgraph GIT["Git"]
        VERSIONADO["✅ Versionado (commita):<br/>workflow-config.yaml<br/>cards/<br/>inventory/<br/>memory/L2-project.yaml<br/>hooks/"]
        LOCAL["❌ Ignorado (.gitignore):<br/>graph.db<br/>memory/L1/ (features ativas)<br/>*.bak<br/>checkpoints .yaml"]
    end

    FILES_CREATED --> GIT

    subgraph TIME["Os outros 9 devs (v1.3+)"]
        PULL["git pull"]
        CONFIG_OK["Recebem versionados:<br/>cards, inventory,<br/>workflow-config, hooks"]
        BOOTSTRAP["bash .claude/bootstrap.sh<br/>(idempotente)"]
        BOOT_STEPS["Step 1-5: linka git hooks,<br/>chmod +x scripts,<br/>pip install -e ."]
        BOOT_STEP6["Step 6: probe<br/>forge graph --json q3<br/>→ dispara lazy auto-build<br/>(_maybe_auto_build)"]
        GRAPH_DB["graph.db local pronto<br/>(~30s-2min)"]
    end

    PULL --> CONFIG_OK
    CONFIG_OK --> BOOTSTRAP
    BOOTSTRAP --> BOOT_STEPS
    BOOT_STEPS --> BOOT_STEP6
    BOOT_STEP6 --> GRAPH_DB

    GIT -->|"commit + push"| PULL

    LAZY["Pulou bootstrap?<br/>Primeira forge graph<br/>dispara o mesmo<br/>lazy auto-build"]
    BOOTSTRAP -.->|"alternativa"| LAZY
    LAZY --> GRAPH_DB

    style VERSIONADO fill:#e3fce3,stroke:#2e7d32
    style LOCAL fill:#ffe3e3,stroke:#c62828
    style GRAPH_DB fill:#fff3e0,stroke:#e65100
    style BOOT_STEP6 fill:#e8eaf6,stroke:#3f51b5
    style LAZY fill:#fff8e1,stroke:#f9a825
