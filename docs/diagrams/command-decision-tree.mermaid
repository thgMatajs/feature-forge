flowchart TD
    ROOT{{"O que você quer fazer?"}}

    ROOT --> F{"Feature nova"}
    ROOT --> B{"Bug / problema"}
    ROOT --> R{"Refatorar"}
    ROOT --> S{"Ver estado"}
    ROOT --> V{"Validar"}
    ROOT --> C{"Configurar"}
    ROOT --> ROAD{"Roteiro / planejar"}
    ROOT --> REV{"Reverter algo"}

    F --> F1["forge plan<br/>→ gera PLAN.md"]
    F --> F2["forge implement<br/>→ executa tasks"]

    B --> B1["forge plan<br/>→ documenta bug"]
    B --> B2["forge implement<br/>→ aplica fix"]
    B --> B3["forge verify<br/>→ confirma correção"]

    R --> R1["forge plan<br/>→ escopo sem mudança<br/>de comportamento"]
    R --> R2["forge implement<br/>→ refatora"]
    R --> R3["forge verify<br/>→ comportamento<br/>preservado"]

    S --> S1["forge status<br/>→ resumo do projeto"]
    S --> S2["forge doctor<br/>→ health check<br/>17 categorias"]
    S --> S3["forge graph<br/>→ menu interativo<br/>Q1-Q17 + r"]
    S --> S3J["forge graph --json &lt;q&gt;<br/>→ non-interactive (IA/CI)<br/>JSON stdout, --no-auto-build<br/>p/ pipelines determinísticos"]

    V --> V1["forge verify<br/>→ validators cascade<br/>(3 built-in + N de cards;<br/>21 no diretório)"]
    V --> V2["forge qa<br/>→ red-team adversarial<br/>multi-agente"]

    C --> C1["forge reconfigure<br/>→ muda config existente"]
    C --> C2["forge init<br/>→ (re)instala do zero<br/>apenas em greenfield"]
    C --> C3["forge evolve<br/>→ propõe evoluções<br/>do catálogo"]
    C --> C4["forge memory<br/>→ gerencia L1/L2<br/>e extrai padrões"]

    ROAD --> ROAD1["forge plan<br/>→ desenha fases + tasks"]
    ROAD --> ROAD2["forge status<br/>→ consulta L2 e<br/>features ativas"]

    REV --> REV1["forge undo<br/>→ reverte por fase<br/>com verificação de<br/>dependências"]
    REV --> REV2["forge status<br/>→ histórico de<br/>commits por slug"]

    style F fill:#e3f2fd,stroke:#1565c0
    style B fill:#ffebee,stroke:#c62828
    style R fill:#fff3e0,stroke:#e65100
    style S fill:#e8f5e9,stroke:#2e7d32
    style V fill:#f3e5f5,stroke:#6a1b9a
    style C fill:#e0f7fa,stroke:#00695c
    style ROAD fill:#fff8e1,stroke:#f9a825
    style REV fill:#fce4ec,stroke:#880e4f
    style S3J fill:#e8eaf6,stroke:#3f51b5
