#!/usr/bin/env bash
# feature-forge — bash dispatcher
#
# Tiny shim: resolves FORGE_HOME, exports env, and execs the Python engine
# in-place so signals (Ctrl+C, SIGTERM) propagate cleanly to the child.
#
# Anything more than this belongs in engine/cli.py. Keep this file boring.

set -euo pipefail

# Resolve the canonical FORGE_HOME (the directory containing bin/ and engine/).
# Follow symlinks so users can symlink `forge` into ~/.local/bin freely.
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
FORGE_HOME="$(cd -P "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"

export FORGE_HOME
export PYTHONPATH="${FORGE_HOME}${PYTHONPATH:+:${PYTHONPATH}}"

PYTHON="${FORGE_PYTHON:-python3}"

# FORGE_VERSION é lido dinamicamente de engine.__version__ (fonte única
# de verdade). Fallback "unknown" mantém o dispatcher operável caso o
# engine não esteja importável (ex.: PYTHONPATH quebrado em smoke).
FORGE_VERSION="$("$PYTHON" -c 'from engine import __version__; print(__version__)' 2>/dev/null || echo unknown)"
export FORGE_VERSION

# DRIFT-1 dispatch (SPEC §6 sub-Q Sd): the dispatcher always execs
# engine.cli. Host context (Claude Code harness vs. real terminal) is
# resolved IN-PROCESS by engine.ui.question through the host adapter
# registry — the dispatcher no longer branches on it.
#
#   - Harness / non-TTY (Claude Code, CI, pipes, subprocess) → the
#     intent-only adapter emits .claude/forge/state/forge-pending.json
#     and exits 2; the host reads it, writes a response, and re-invokes
#     with the same argv.
#   - Real interactive terminal → TtyAdapter reads stdin directly,
#     single-pass, in-process. No subprocess bridge, no state files.
#
# Wave 2 clean break: the old engine.ui.tty_bridge subprocess-loop is
# gone. Terminal-real prompting now lives in TtyAdapter
# (engine/host/adapters/tty.py), wired through question._resolve_adapter.
# The dispatcher dropped the force-tty override branch and the default
# bridge fallthrough — there is a single exec target.
#
# Detection signals (CLAUDECODE / non-TTY / FORGE_FORCE_INTENT_MODE) still
# matter, but they are honoured on the Python side by the adapter registry,
# not here. The dispatcher stays boring: resolve env, exec.
#
# exec so Ctrl+C goes straight to the engine (Decision 27: pause vs abort).
exec "$PYTHON" -m engine.cli "$@"
