#!/usr/bin/env bash
# feature-forge — bash dispatcher
#
# Tiny shim: resolves FORGE_HOME, exports env, and execs the Python engine
# in-place so signals (Ctrl+C, SIGTERM) propagate cleanly to the child.
#
# Anything more than this belongs in engine/cli.py. Keep this file boring.

set -euo pipefail

# Resolve the canonical FORGE_HOME (the directory containing bin/ and engine/).
# Follow symlinks so users can symlink `forge` into ~/.local/bin freely.
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
FORGE_HOME="$(cd -P "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"

export FORGE_HOME
export PYTHONPATH="${FORGE_HOME}${PYTHONPATH:+:${PYTHONPATH}}"

PYTHON="${FORGE_PYTHON:-python3}"

# FORGE_VERSION é lido dinamicamente de engine.__version__ (fonte única
# de verdade). Fallback "unknown" mantém o dispatcher operável caso o
# engine não esteja importável (ex.: PYTHONPATH quebrado em smoke).
FORGE_VERSION="$("$PYTHON" -c 'from engine import __version__; print(__version__)' 2>/dev/null || echo unknown)"
export FORGE_VERSION

# DRIFT-1 dispatch (SPEC §6 sub-Q Sd): route between intent-only mode
# (engine.cli) and TTY-fallback bridge (engine.ui.tty_bridge) based on
# host context. Intent-only is the canonical path when Claude Code or
# any other harness fronts stdin/stdout; the bridge only runs against a
# real terminal where the legacy interactive prompts must keep working.
#
# Detection signals (in priority order, any one trips intent-only mode):
#   - CLAUDECODE set             — set to "1" by Claude Code (verified vs
#                                  2.1.153); also see CLAUDE_CODE_ENTRYPOINT/
#                                  SESSION_ID/EXECPATH companions. Early-
#                                  detection bonus; the TTY checks below
#                                  remain the load-bearing fallback if
#                                  Claude Code ever renames this.
#   - stdin or stdout not a TTY  — CI, redirect, subprocess. Canonical
#                                  Unix non-interactive signal.
#   - FORGE_FORCE_INTENT_MODE=1  — explicit override for tests / debug.
#
# Anything else falls through to the bridge (real terminal). The bridge
# itself execs engine.cli as a subprocess and intercepts exit 2; see
# engine/ui/tty_bridge.py docstring for the protocol contract.
#
# Precedência:
#   1. FORGE_FORCE_TTY_MODE=1   — override explícito pra bridge (vence
#                                  até detecção automática de Claude Code
#                                  ou non-TTY; útil pra debug do bridge
#                                  rodando dentro de harness).
#   2. Sinais de intent-mode    — CLAUDECODE / non-TTY / FORGE_FORCE_INTENT_MODE.
#   3. Fallback default          — bridge (terminal real interativo).
#
# exec so Ctrl+C goes straight to the engine (Decision 27: pause vs abort).
if [[ -n "${FORGE_FORCE_TTY_MODE:-}" ]]; then
  exec "$PYTHON" -m engine.ui.tty_bridge engine.cli "$@"
elif [[ -n "${CLAUDECODE:-}" ]] \
   || [[ ! -t 0 ]] \
   || [[ ! -t 1 ]] \
   || [[ -n "${FORGE_FORCE_INTENT_MODE:-}" ]]; then
  exec "$PYTHON" -m engine.cli "$@"
else
  exec "$PYTHON" -m engine.ui.tty_bridge engine.cli "$@"
fi
