def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="mem", description="Project memory for code agents.")
    parser.add_argument("--version", action="version", version=f"mem {__version__}")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--debug", action="store_true", help="show tracebacks")
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("rebuild", help="rebuild the derived index from JSONL")
    p_add = sub.add_parser("add", help="record a memory")
    p_add.add_argument("--type", required=True, choices=sorted(VALID_TYPES))
    p_add.add_argument("-i", "--importance", type=int, default=3)
    p_add.add_argument("-t", "--title", required=True)
    p_add.add_argument("--tags", default="")
    p_add.add_argument("--source", default=None)
    p_add.add_argument("body")
    p_find = sub.add_parser("find", help="search memories (ranked, titles only)")
    p_find.add_argument("query")
    p_find.add_argument("--type", choices=sorted(VALID_TYPES), default=None)
    p_find.add_argument("-k", type=int, default=5)
    p_find.add_argument("--since", default=None,
                        help="only memories created within a window, e.g. 30m, 24h, 7d, 2w")
    p_find.add_argument("--all", action="store_true",
                        help="include archived/superseded memories")
    p_get = sub.add_parser("get", help="fetch a memory body by id (registers access)")
    p_get.add_argument("id")
    p_stats = sub.add_parser("stats", help="counts, vitality (live/stale), top-accessed")
    p_stats.add_argument("--min-score", type=float, default=DEFAULT_MIN_SCORE,
                         dest="min_score", help="standing-score threshold for stale")
    p_stats.add_argument("--max-age-days", type=float, default=DEFAULT_MAX_AGE_DAYS,
                         dest="max_age_days", help="min days since access for stale")
    p_sup = sub.add_parser("supersede",
                           help="mark OLD_ID superseded by NEW_ID (usage: supersede NEW_ID OLD_ID)")
    p_sup.add_argument("new_id", metavar="NEW_ID", help="the replacement memory id")
    p_sup.add_argument("old_id", metavar="OLD_ID", help="the memory being superseded")
    p_init = sub.add_parser("init", help="scaffold mem in this repo (idempotent)")
    p_init.add_argument("--vendor", action="store_true", help="also copy the script to .claude/bin/mem")
    sub.add_parser("vendor", help="copy this script into .claude/bin/mem + scaffold")
    sub.add_parser("doctor", help="diagnose install, schema, version drift")
    p_up = sub.add_parser("update", help="self-update the vendored copy from the latest release")
    p_up.add_argument("--check", action="store_true", help="only report drift")
    p_up.add_argument("--ref", default=None, help="pin a specific tag")
    p_imp = sub.add_parser(
        "import",
        help="ingest native markdown memories (file or dir); additive/one-shot — re-running duplicates",
    )
    p_imp.add_argument("path")
    p_session = sub.add_parser("session", help="record a session summary (auto git_meta)")
    p_session.add_argument("summary")
    p_session.add_argument("-i", "--importance", type=int, default=2)
    p_session.add_argument("--tags", default="")
    p_session.add_argument("--source", default=None)
    p_issue = sub.add_parser("issue", help="file a bug/feature report against mem itself (gh)")
    p_issue.add_argument("--title", required=True, help="short issue title")
    p_issue.add_argument("--body", default=None, help="what happened (goes into the template)")
    p_issue.add_argument("--kind", default="bug", choices=list(_ISSUE_KINDS),
                         help="bug | feature | rough-edge (default: bug)")
    p_issue.add_argument("--dry-run", action="store_true", dest="dry_run",
                         help="print the composed title+body; do not call gh")
    p_evolve = sub.add_parser("evolve", help="propose archive/dup curation (read-only by default)")
    p_evolve.add_argument("--apply", action="store_true",
                          help="write archived status for own-author archive candidates")
    p_evolve.add_argument("--yes", action="store_true", help="alias for --apply (non-TTY safe)")
    p_evolve.add_argument("--min-score", type=float, default=DEFAULT_MIN_SCORE,
                          dest="min_score", help="standing-score threshold for archive")
    p_evolve.add_argument("--max-age-days", type=float, default=DEFAULT_MAX_AGE_DAYS,
                          dest="max_age_days", help="min days since access for archive")
    sub.add_parser("compact", help="rewrite your own JSONL, dropping archived memories")
    p_inbox = sub.add_parser("inbox", help="capture-candidate inbox (local-only)")
    inbox_sub = p_inbox.add_subparsers(dest="inbox_action", required=True)
    pi_add = inbox_sub.add_parser("add", help="add a capture candidate")
    pi_add.add_argument("--type", required=True, choices=sorted(INBOX_TYPES))
    pi_add.add_argument("-i", "--importance", type=int, default=3)
    pi_add.add_argument("-t", "--title", required=True)
    pi_add.add_argument("--tags", default="")
    pi_add.add_argument("--source", default=None)
    pi_add.add_argument("--origin", default="manual",
                        choices=["manual", "haiku", "correction-signal"])
    pi_add.add_argument("body")
    pi_list = inbox_sub.add_parser("list", help="list candidates (pending by default)")
    pi_list.add_argument("--all", action="store_true", help="include promoted/rejected")
    pi_promote = inbox_sub.add_parser("promote", help="promote a candidate to a real memory")
    pi_promote.add_argument("id")
    pi_promote.add_argument("--yes", action="store_true", help="non-TTY confirmation")
    pi_reject = inbox_sub.add_parser("reject", help="reject a candidate")
    pi_reject.add_argument("id")
    p_hook = sub.add_parser("hook", help="hook handlers (read the event JSON on stdin)")
    hook_sub = p_hook.add_subparsers(dest="hook_action", required=True)
    hook_sub.add_parser("prompt", help="UserPromptSubmit: queue correction signals to the inbox")
    hook_sub.add_parser("stop", help="Stop: nudge consolidation on significant uncaptured work")
    hook_sub.add_parser("session-start", help="SessionStart: inject the brief")
    hook_sub.add_parser("post-tool", help="PostToolUse: inject reactive trigger matches")
    p_ih = sub.add_parser("install-hooks", help="wire mem hooks into .claude/settings.json")
    p_ih.add_argument("--tool", default="claude-code", help="target tool (only claude-code)")
    p_ih.add_argument("--apply", action="store_true", help="write changes (default: dry-run)")
    p_trig = sub.add_parser("trigger", help="manage reactive-injection triggers (committed)")
    trig_sub = p_trig.add_subparsers(dest="trigger_action", required=True)
    pt_add = trig_sub.add_parser("add", help="author a trigger")
    pt_add.add_argument("--event", default="post-edit", choices=["post-edit"])
    pt_add.add_argument("--glob", required=True)
    pt_add.add_argument("--tags", required=True)
    pt_add.add_argument("--budget", type=int, default=300)
    pt_list = trig_sub.add_parser("list", help="list triggers + local stats")
    pt_list.add_argument("--all", action="store_true", help="include disabled")
    pt_rm = trig_sub.add_parser("rm", help="disable a trigger (event-sourced, recoverable)")
    pt_rm.add_argument("id")
    p_brief = sub.add_parser("brief", help="high-value index for session start (no access logged)")
    p_brief.add_argument("--budget", type=int, default=800)
    p_cp = sub.add_parser("checkpoint", help="show the session-continuity checkpoint (read-only)")
    p_cp.add_argument("--json", action="store_true")
    p_fire = sub.add_parser("fire", help="reactive injection for a path event (no access logged)")
    p_fire.add_argument("--event", default="post-edit", choices=["post-edit"])
    p_fire.add_argument("--path", required=True)
    p_fire.add_argument("--session", default="")
    p_fire.add_argument("--budget", type=int, default=None,
                        help="optional per-trigger token cap (default: each trigger's own budget)")
    p_fire.add_argument("--session-budget", type=int, default=_HOOK_SESSION_BUDGET,
                        dest="session_budget")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    cmd = getattr(args, "command", None)
    if not cmd:
        parser.print_help()
        return 1
    handler = COMMANDS.get(cmd)
    if handler is None:
        parser.print_help()
        return 1
    try:
        return handler(args)
    except MemError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return exc.exit_code
    except Exception as exc:  # top-level guard, R-output discipline
        if getattr(args, "debug", False):
            raise
        print(f"internal error: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
