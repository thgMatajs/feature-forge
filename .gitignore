# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# feature-forge — runtime artifacts (never committed)
*.bak
.init-checkpoint.yaml
.reconfigure-draft.yaml
.evolve-checkpoint.yaml
graph.db
graph.db-journal
graph.db-wal

# Build / dist
build/
dist/
*.egg

# Local-only project state (when forge runs inside another project)
.claude/graph.db
.claude/memory/L1/*
!.claude/memory/L1/archived/

# Claude Code — runtime state (per-session, não versionado)
.claude/state/*.json
.claude/state/*.jsonl
.claude/state/*.lock
!.claude/state/.gitkeep

# Claude Code — worktrees (git linked-worktrees criadas por subagentes)
.claude/worktrees/

# GSD / superpowers — temporary scratch
.gsd-tmp/

# Plan auditor + review subagents — review outputs (per-rodada, não versionado)
.planning/plan-reviews/
.planning/code-reviews/
.planning/final-review/
.planning/master-review/

# Per-phase planning artifacts (per-session, não versionado)
# Manter .planning/ root track, ignorar subdirs por padrão exceto specs/plans canônicos
.planning/*-review/
.planning/rebase-*/
.planning/*-fixes-review/

# Ultra-review skill outputs
.ultra-review/

# Design outputs (generated artifacts)
docs/design/outputs/
