# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# feature-forge — runtime artifacts (never committed)
*.bak
.init-checkpoint.yaml
.reconfigure-draft.yaml
.evolve-checkpoint.yaml
graph.db
graph.db-journal
graph.db-wal

# Build / dist
build/
dist/
*.egg

# Local-only project state (when forge runs inside another project)
.claude/graph.db
.claude/memory/L1/*
!.claude/memory/L1/archived/

# Claude Code — runtime state (per-session, não versionado)
.claude/state/*.json
.claude/state/*.jsonl
!.claude/state/.gitkeep

# Claude Code — worktrees (git linked-worktrees criadas por subagentes)
.claude/worktrees/

# GSD / superpowers — temporary scratch
.gsd-tmp/

# .planning/ — per-session scratch (review outputs, audit dirs, fix workspaces)
# Default: tudo ignorado. Whitelist explícita pra artefatos persistentes
# que são deliberadamente versionados (audit JSONs + verification md de
# phases canônicas).
.planning/*
!.planning/.gitkeep
!.planning/det-3/
!.planning/det-6/
!.planning/drift-1/

# Ultra-review skill outputs
.ultra-review/

# Design outputs (generated artifacts)
docs/design/outputs/
